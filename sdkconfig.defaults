CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_TWO_OTA_LARGE=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

CONFIG_BEESCALE_OTA_URL="https://github.com/fransstrom/hive-scale/releases/latest/download/beescale.bin"
CONFIG_BEESCALE_OTA_CHECK_INTERVAL_WAKEUPS=1
CONFIG_BEESCALE_WIFI_CONNECT_TIMEOUT_SECONDS=30


CONFIG_GPIO_HX711_DOUT=5
CONFIG_GPIO_HX711_SCK=4
